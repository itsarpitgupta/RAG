# Example Environment Configuration
GROQ_API_KEY=your_groq_api_key_here
USER_AGENT=RAGWorkflow/1.0

# Centralized LLM Model Configuration
# Available Free Models:
# - "openai/gpt-oss-120b" (Flagship 120B model on Groq - best for agents & reasoning)
# - "qwen/qwen3.8-27b"    (Fast 27B model on Groq - high throughput & tool calling)
# - "openai/gpt-oss-20b"  (Lightweight 20B model on Groq - minimal rate-limit impact)
# - "allam-2-7b"          (Ultra-fast 7B model on Groq)
# - "gemini-3.8-flash"    (Google GenAI via GOOGLE_API_KEY)
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
LLM_ENABLE_FALLBACKS=True

# Google AI Studio (Optional for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# Neo4j Graph Database
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
